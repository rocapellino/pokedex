{
  "name": "pokedex",
  "version": "1.99.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@pokedex/backend",
    "build": "npm run build --workspace=@pokedex/backend && npm run build --workspace=@pokedex/frontend",
    "build:backend": "npm run build --workspace=@pokedex/backend",
    "build:frontend": "npm run build --workspace=@pokedex/frontend",
    "seed": "npm run seed --workspace=@pokedex/backend",
    "catalog:generate": "tsx scripts/generate-pokemon-catalog.ts",
    "start": "npm run start --workspace=@pokedex/backend",
    "typecheck": "tsc --noEmit",
    "lint:md": "tsx scripts/lint-markdown.ts",
    "lint:md:fix": "tsx scripts/lint-markdown.ts --fix",
    "lint:ignore": "tsx scripts/check-ignore-hygiene.ts",
    "lint:ignore:strict": "tsx scripts/check-ignore-hygiene.ts --strict",
    "lint:ignore:fix": "tsx scripts/check-ignore-hygiene.ts --fix",
    "lint:yaml": "tsx scripts/check-yaml-extension.ts",
    "lint:yaml:strict": "tsx scripts/check-yaml-extension.ts --strict",
    "lint:docs:refs": "tsx scripts/check-yaml-extension.ts --refs",
    "lint:docs:refs:fix": "tsx scripts/check-yaml-extension.ts --refs --fix",
    "docs:validate": "tsx scripts/validate-docs-governance.ts",
    "lint:ruleset": "tsx scripts/check-ruleset-parity.ts",
    "nginx:conf": "node scripts/generate-nginx-conf.mjs",
    "nginx:conf:check": "node scripts/generate-nginx-conf.mjs --check",
    "lint:code": "biome check .",
    "format": "biome format --write .",
    "lint": "npm run lint:code && npm run lint --workspace=@pokedex/backend && npm run lint --workspace=@pokedex/frontend && npm run typecheck",
    "validate": "npm run lint && npm run lint:ignore && npm run lint:yaml && npm run test:surface:check && npm run build && npm test && npm run test:fuzz",
    "test": "tsx --test \"tests/**/!(*fuzzing*).test.ts\"",
    "test:all": "tsx --test \"tests/**/*.test.ts\"",
    "test:unit": "tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "tsx --test \"tests/integration/**/*.test.ts\"",
    "test:security": "tsx --test \"tests/security/**/*.test.ts\" tests/security.test.ts tests/pentest.test.ts",
    "test:gitops": "tsx --test \"tests/gitops/**/*.test.ts\"",
    "test:coverage": "node -e \"fs.mkdirSync('coverage',{recursive:true})\" && tsx --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/**/!(*fuzzing*).test.ts\"",
    "test:fuzz": "tsx --test tests/fuzzing.test.ts",
    "test:surface": "tsx scripts/test-surface.ts",
    "test:surface:check": "tsx scripts/test-surface.ts --check",
    "test:surface:update": "tsx scripts/test-surface.ts --update",
    "dr:drill:e2e": "tsx scripts/dr-drill.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test -g @a11y",
    "playwright:install": "playwright install chromium",
    "perf:lighthouse": "lhci autorun",
    "commitlint": "commitlint --edit",
    "secrets:audit-rotation": "node --experimental-strip-types scripts/verify-secret-rotation.ts",
    "governance:audit-scripts": "tsx --test tests/security/iac_baseline_security.test.ts tests/security/ansible_baseline_security.test.ts tests/security/opentofu_baseline_security.test.ts",
    "gitops:verify-parity": "node --experimental-strip-types scripts/verify-image-digest-parity.ts",
    "gitops:verify-parity:strict": "node --experimental-strip-types scripts/verify-image-digest-parity.ts --strict",
    "gitops:pin": "node --experimental-strip-types scripts/update-gitops-pin.ts",
    "gitops:pin:check": "node --experimental-strip-types scripts/update-gitops-pin.ts --check",
    "test:security:egress": "node --experimental-strip-types --test tests/security/egress_anti_ssrf.test.ts",
    "probe:security:egress": "node --experimental-strip-types scripts/probe-egress-security.ts --simulate --profile=cilium-l7",
    "k8s:rollout-restart": "node --experimental-strip-types scripts/k8s-rollout-restart.ts",
    "k8s:verify-vault-architecture": "node --experimental-strip-types scripts/k8s-rollout-restart.ts --simulate",
    "ghcr:retention": "node --experimental-strip-types scripts/ghcr-retention.ts",
    "ghcr:retention:dry-run": "node --experimental-strip-types scripts/ghcr-retention.ts --dry-run",
    "ci:detect-impact": "tsx scripts/detect-change-impact.ts",
    "pr:validate": "tsx scripts/validate-pr-body.ts",
    "linear:sonar-sync": "node --experimental-strip-types scripts/sonar-linear-sync.ts",
    "linear:security-sync": "tsx scripts/github-security-linear-sync.ts",
    "aas:governance": "tsx scripts/aas-governance.ts",
    "aas:validate": "npm exec --yes --ignore-scripts --package=agentic-awesome-skills@18.6.0 -- aas stack validate --manifest .agents/aas/aas-stack.json",
    "aas:verify": "npm run aas:governance && npm run aas:validate",
    "db:generate": "npm run db:generate --workspace=@pokedex/backend",
    "db:migrate": "npm run db:migrate --workspace=@pokedex/backend",
    "db:studio": "npm run db:studio --workspace=@pokedex/backend"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "tmp": "^0.2.6",
    "cookie": "^2.0.1",
    "esbuild": "^0.28.2",
    "@puppeteer/browsers": "^3.0.0",
    "proxy-agent": "^8.0.2",
    "basic-ftp": "^6.2.1",
    "markdownlint-cli": {
      "js-yaml": "^5.4.2",
      "katex": "^0.18.11",
      "smol-toml": "^1.9.0"
    },
    "@lhci/utils": {
      "js-yaml": "^5.4.2"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.1.1",
    "markdownlint-cli": "^0.49.1",
    "tsx": "^4.19.3",
    "typescript": "~7.0.2"
  }
}
