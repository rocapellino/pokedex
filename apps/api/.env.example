# Configuración del Servidor API
PORT=5000
ENVIRONMENT=development

# Configuración de Base de Datos PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pokedex_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/pokedex_db

# Configuración de Caché Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Seguridad y CORS (Orígenes separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5000

# Autenticación API — OBLIGATORIAS, la API no arranca sin ellas
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=your_secure_random_admin_key_here
AI_API_KEY=your_secure_random_ai_key_here

# Google AI Studio API Key (Gemini & Imagen 3)
GEMINI_API_KEY=your_google_ai_studio_api_key_here
