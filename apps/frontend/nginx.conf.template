server {
    listen 8080;
    server_name localhost;

    # Ocultar versión de Nginx en cabeceras de respuesta HTTP
    server_tokens off;

    # Límite máximo de payload para mitigar ataques DoS
    client_max_body_size 10M;

    root /usr/share/nginx/html;
    index index.html index.htm;

    # Cabeceras de seguridad globales
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # HSTS: forzar HTTPS en conexiones protegidas por TLS Ingress o Reverse Proxy
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # CSP: permite scripts propios (sin 'unsafe-inline'), estilos propios con Google Fonts, imágenes de GitHub y data URIs.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https://raw.githubusercontent.com data: blob:; connect-src 'self'; font-src 'self' https://fonts.gstatic.com; object-src 'none'; frame-ancestors 'self';" always;

    # 1. Estrategia de Caché para Assets Estáticos (CSS, JS, Fuentes, Imágenes)
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400, stale-while-revalidate=3600" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # 2. Backoffice CRUD — restringido estrictamente a acceso local y bastion de administración
    #    IPs configuradas vía variables de entorno (envsubst al arrancar el contenedor).
    #    Valores por defecto en .env.example; sobreescribir por ambiente en Helm values o docker-compose.
    #    La segmentación inter-cluster se complementa con NetworkPolicies de Kubernetes.
    location ~* ^/(admin|backoffice|backoffice\.html) {
        allow 127.0.0.1;
        allow ::1;
        allow ${BACKOFFICE_ALLOWED_IP_1};    # Kubernetes Ingress / API Server gateway
        allow ${BACKOFFICE_ALLOWED_IP_2};    # Host Bastion / VPN de gestión administrativa
        deny all;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        try_files /backoffice.html =404;
    }

    # 3. Archivos estáticos y Pokédex Pública (Frontend SPA)
    location / {
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files $uri $uri/ /index.html;
    }

    # 3. Proxy inverso hacia el backend API Node.js / Express (/api/)
    location /api/ {
        rewrite ^/api/(.*) /$1 break;
        proxy_pass http://api:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 4. Proxy directo para endpoints REST /pokemons
    location /pokemons {
        proxy_pass http://api:3000/pokemons;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 5. Endpoint de métricas de Prometheus — restringido a scrapers autorizados
    #    CIDR configurado vía variable de entorno (envsubst al arrancar el contenedor).
    #    No expuesto públicamente a través del LB/Ingress.
    location /metrics {
        allow 127.0.0.1;
        allow ::1;
        allow 172.28.0.0/16;              # Red monitoring-net dedicada de Docker Compose
        allow ${METRICS_ALLOWED_CIDR};    # Subred de scraping Prometheus (configurable por cluster)
        deny all;
        proxy_pass http://api:3000/metrics;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # 6. Healthcheck para Nginx
    location /healthz {
        access_log off;
        return 200 "healthy\n";
    }
}
