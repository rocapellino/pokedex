{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "../../",
    "paths": {
      "@pokedex/contracts": ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": ["server.ts", "src/**/*", "../../packages/contracts/src/**/*"]
}
