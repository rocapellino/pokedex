{
  "name": "@pokedex/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild src/seed.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/seed.cjs",
    "seed": "tsx src/seed.ts",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "2.21.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0"
  },
  "overrides": {
    "qs": "^6.14.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3"
  }
}
