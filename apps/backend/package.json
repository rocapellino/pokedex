{
  "name": "@pokedex/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js && esbuild src/seed.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/seed.js && esbuild src/db/migrate.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/migrate.js && node -e \"fs.cpSync('src/db/migrations', 'dist/migrations', {recursive: true})\"",
    "seed": "tsx src/seed.ts",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:lint-migrations": "tsx ../../scripts/check-migration-hygiene.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "@pokedex/contracts": "*",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.3",
    "typescript": "~7.0.2"
  }
}
