.nyc_output/
reports/
*.lcov
.pytest_cache/
.coverage
.coverage.*
test-results/
playwright-report/
lighthouse-results/
.lighthouseci/
.scannerwork/
.sonarlint/

# ==============================================================================
# Secretos, Claves y Variables de Entorno (Zero-Trust)
# ==============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets/
*.secrets
.tools/

# ==============================================================================
# OpenTofu & IaC (Infraestructura como Código)
# ==============================================================================
**/.terraform/*
**/.tofu/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.tofurc
*.lock.info

# ==============================================================================
# Ansible Automation & Playbooks
# ==============================================================================
*.retry

