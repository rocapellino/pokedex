# ==============================================================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# Logs generales
*.log

# ==============================================================================
# Residuos de Scripts Locales y Artefactos Temporales
# ==============================================================================
# Directorios temporales generados por scripts/dr-drill.ts durante simulacros
scratch/

# Directorio canónico de artefactos temporales y efímeros (repository-hygiene)
/tmp/

# Artefactos efímeros de AAS Core (manifests y revisión sí se versionan)
.agents/aas/plans/*
!.agents/aas/plans/.gitkeep
.agents/aas/cache/
.agents/aas/runtime/
.agents/aas/materialized/
