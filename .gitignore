# ==============================================================================
node_modules/
dist/
build/
.npm/
*.tsbuildinfo
dist-ssr/

# Logs de gestores de paquetes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

