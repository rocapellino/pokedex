        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "detail": "Levanta el entorno de Desarrollo con hot-reload en vivo, puertos SQL/Redis expuestos y volúmenes montados."
    },
