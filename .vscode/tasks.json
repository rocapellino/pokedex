  //
  // Motivo (VSCODE-001/004): este archivo contenia comandos `helm`/`kubectl`
  // directos que ya existian en el Taskfile, lo que generaba dos fuentes de
  // verdad con divergencia silenciosa. Ejemplo real: la tarea "Test Endpoints"
  // consultaba `deploy/pokemon-api` mientras `task k8s:test` consulta
  // `deploy/pokemon-api` Y `deploy/pokedex-web`.
  //
  // Regla de mantenimiento: si anades logica aqui, va al Taskfile.
  // ==========================================================================
  "version": "2.0.0",
  "tasks": [
