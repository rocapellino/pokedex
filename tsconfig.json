{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@pokedex/contracts": ["./packages/contracts/src/index.ts"]
    }
  },
  "include": ["apps/backend/server.ts", "apps/backend/src/**/*", "packages/contracts/src/**/*", "scripts/**/*", "tests/**/*", "playwright.config.ts"]
}
