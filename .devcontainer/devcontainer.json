{
  "name": "Pokédex Platform DevContainer",
  // El workspace se monta en la MISMA ruta que en el host: con docker-outside-of-docker el daemon es el del host y
  // resuelve los bind mounts relativos de docker-compose.dev.yaml (./apps/frontend/dist, config de Alloy) contra esa ruta;
  // con otra ruta de destino llegan vacíos. Requiere abrir el repo desde una ruta Linux (WSL2, macOS o Linux), no desde C:\.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",

  // Imagen base oficial alineada con Node.js 22 LTS.
  // Política de actualización: tag LTS activo fijado por digest SHA-256 (igual que los Dockerfiles de apps/);
  // Renovate (manager 'devcontainer') propone los bumps de tag y digest. Contrato: tests/security/devcontainer_supply_chain.test.ts.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm@sha256:7c2e711a4f7b02f32d2da16192d5e05aa7c95279be4ce889cff5df316f251c1d",

  // Features del entorno de desarrollo.
  // Las versiones exactas y digests SHA-256 están gobernados contractualmente por .devcontainer/devcontainer-lock.json.
  // Proveedores: 'devcontainers' (oficial) y 'devcontainers-extra' (comunidad de supply chain para kind y go-task).
  "features": {
    // Docker outside-of-Docker: Comparte el Docker daemon del host para permitir docker build y orquestación con Kind.
    // Frontera de seguridad: decisión deliberada para desarrollo local con paridad de infraestructura.
    // 'latest' es aceptable aquí: solo instala el cliente Docker (el daemon es el del host) y la feature queda fijada en el lock.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "enableNonRootDocker": true
    },
    // Herramientas CLI de Kubernetes alineadas con .tool-versions (kubectl 1.30.0, helm 3.17.0).
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "1.30.0",
      "helm": "3.17.0",
      "minikube": "none"
    },
    // Kind (Kubernetes in Docker): Requerido para task dev:k8s:up y validación de paridad K8s local (infra/k8s/kind-cluster.yaml).
    "ghcr.io/devcontainers-extra/features/kind:1": {
      "version": "0.33.0"
    },
    // Task (Go-Task): Motor de ejecución de tareas del monorepo definido en Taskfile.yaml.
    "ghcr.io/devcontainers-extra/features/go-task:1": {
      "version": "3.54.0"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "typescript.tsdk": "node_modules/typescript/lib"
      },
      "extensions": [
        "SonarSource.sonarlint-vscode",
        "biomejs.biome",
        "ms-azuretools.vscode-docker",
        "ms-playwright.playwright",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "eamodio.gitlens"
      ]
    }
  },
  "forwardPorts": [3000, 8080, 5432, 6379],
  "portsAttributes": {
    // Contrato de puertos: 3000 es el puerto nativo interno del contenedor (API Backend).
    // En el host, docker-compose.dev.yaml publica ${API_DEV_PORT:-3001}:3000 para evitar colisiones con Grafana (3000).
    "3000": {
      "label": "Pokédex API Backend (Container: 3000 | Compose Host: 3001)",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Pokédex Web Frontend",
      "onAutoForward": "openBrowser"
    },
    "5432": {
      "label": "PostgreSQL Database",
      "onAutoForward": "silent"
    },
    "6379": {
      "label": "Redis Cache",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "npm ci --ignore-scripts && npx --no-install playwright install --with-deps chromium",
  "remoteUser": "node"
}
