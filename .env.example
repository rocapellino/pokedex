# ==============================================================================
# .env.example — Pokédex API & Frontend
# ==============================================================================
# Copia este archivo como .env en la raíz del repositorio y completa los valores.
# NUNCA commitear el archivo .env real (ya está en .gitignore).
#
# Variables marcadas con [REQUERIDO en prod] causan error de arranque si faltan
# cuando NODE_ENV=production (ver src/config/startup-env-check.ts).
# ==============================================================================

# ------------------------------------------------------------------------------
# Entorno de Ejecución
# ------------------------------------------------------------------------------
NODE_ENV=development
# Valores: development | production | test

# ------------------------------------------------------------------------------
# Servidor Express
# ------------------------------------------------------------------------------
PORT=3000
WEB_PORT=8080

# Versión de la app expuesta en GET /version (inyectada por CI/CD en producción)
APP_VERSION=
# SHA del commit expuesto en GET /version (inyectado por CI/CD)
GIT_SHA=
COMMIT_SHA=

# ------------------------------------------------------------------------------
# Credenciales Administrativas  [REQUERIDO en prod]
# ------------------------------------------------------------------------------
ADMIN_API_KEY=
# Clave API maestra para acceso a endpoints de administración y emisión de tokens.
# Mínimo 32 caracteres aleatorios. Generar con: openssl rand -hex 32

ADMIN_SESSION_SECRET=
# Secreto HMAC para firmar tokens de sesión de corta duración (8h).
# Mínimo 32 bytes. Generar con: openssl rand -hex 32

# IPs autorizadas para acceder al panel /backoffice desde Express (CSV, vacío = sin restricción IP extra)
# Ejemplo: ADMIN_ALLOWED_IPS=10.42.0.1,192.168.1.50
ADMIN_ALLOWED_IPS=

# ------------------------------------------------------------------------------
# CORS  [REQUERIDO en prod]
# ------------------------------------------------------------------------------
CORS_ORIGINS=
# Lista de orígenes autorizados separados por coma.
# En producción es obligatorio. Ejemplo: https://pokedex.example.com,https://www.pokedex.example.com
# En desarrollo, si se deja vacío, solo se permiten orígenes localhost/127.0.0.1.

# ------------------------------------------------------------------------------
# Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
DATABASE_URL=
# String de conexión completo. Si se define, tiene precedencia sobre las variables POSTGRES_*.
# Formato: postgresql://usuario:contraseña@host:puerto/base_de_datos

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pokedex_app
POSTGRES_PASSWORD=
POSTGRES_DB=pokedex_db

# SSL para la conexión a PostgreSQL
# En producción se activa automáticamente si el host no es loopback.
# DB_SSL=true  → forzar SSL siempre
# DB_SSL=false → deshabilitar SSL siempre (solo para dev local sin TLS)
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=
# Si es "true", verifica el certificado CA del servidor Postgres. Requiere DB_SSL=true.

# ------------------------------------------------------------------------------
# Redis (Rate Limiting Distribuido + Revocación de Sesiones)
# ------------------------------------------------------------------------------
REDIS_URL=
# String de conexión completo. Si se define, tiene precedencia sobre REDIS_HOST/PORT.
# Formato: redis://:contraseña@host:puerto

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Google Gemini AI
# ------------------------------------------------------------------------------
AI_API_KEY=
GEMINI_API_KEY=
# API Key para Google Gemini. Si falta, los endpoints /api/v1/ai/* operan en modo fallback.

GEMINI_MODEL=gemini-2.5-flash
# Modelo a utilizar. Default: gemini-2.5-flash
# Referencia: https://ai.google.dev/gemini-api/docs/models/gemini

# ------------------------------------------------------------------------------
# Flags de Seguridad y Comportamiento
# ------------------------------------------------------------------------------
ENABLE_REPO_DOWNLOAD=
# En producción, el endpoint GET /download está BLOQUEADO por defecto (403).
# Para habilitarlo explícitamente: ENABLE_REPO_DOWNLOAD=true

SKIP_ENV_CHECK=
# Si es "true", omite el chequeo de variables de entorno al arrancar.
# Útil en entornos CI/CD con configuración efímera. No usar en producción.

FORCE_SEED=
# Si es "true", ejecuta la siembra de datos aunque la base de datos ya tenga registros.
# Usar solo para resets de datos en desarrollo.

# ------------------------------------------------------------------------------
# Nginx Frontend — Variables para envsubst (IP Allowlist)
# Se inyectan al contenedor del frontend para reemplazar las plantillas en nginx.conf.template
# ------------------------------------------------------------------------------
BACKOFFICE_ALLOWED_IP_1=10.42.0.1/32
# IP del Kubernetes Ingress / API Server gateway (ajustar por cluster)

BACKOFFICE_ALLOWED_IP_2=192.168.1.50/32
# IP del host Bastion / VPN de gestión administrativa (ajustar por ambiente)

METRICS_ALLOWED_CIDR=10.42.0.0/24
# Subred de scraping de Prometheus (ajustar por cluster)

# ------------------------------------------------------------------------------
# Observabilidad (OpenTelemetry)
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
# Endpoint del colector OTLP (Tempo, Jaeger, etc.).
# Ejemplo: http://tempo:4317
# Si se deja vacío, no se exportan trazas OTLP.