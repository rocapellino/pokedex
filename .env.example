# ==============================================================================
# .env.example — Pokédex API & Frontend
# ==============================================================================
# Copia este archivo como .env en la raíz del repositorio y completa los valores.
# NUNCA commitear el archivo .env real (ya está en .gitignore).
#
# Variables marcadas con [REQUERIDO en prod] causan error de arranque si faltan
# cuando NODE_ENV=production (ver src/config/startup-env-check.ts).
# ==============================================================================

# ------------------------------------------------------------------------------
# Entorno de Ejecución
# ------------------------------------------------------------------------------
NODE_ENV=development
# Valores: development | production | test

# ------------------------------------------------------------------------------
# Servidor Express
# ------------------------------------------------------------------------------
PORT=3000
WEB_PORT=8080

# Puerto del host para acceso directo a la API en docker-compose.dev.yaml (evita colisión con Grafana en 3000)
API_DEV_PORT=3001

# Versión de la app expuesta en GET /version (inyectada por CI/CD en producción)
APP_VERSION=
# SHA del commit expuesto en GET /version (inyectado por CI/CD)
GIT_SHA=
COMMIT_SHA=

# ------------------------------------------------------------------------------
# Credenciales Administrativas  [REQUERIDO en prod]
# ------------------------------------------------------------------------------
ADMIN_API_KEY=
# Clave API maestra para acceso a endpoints de administración y emisión de tokens.
# Mínimo 32 caracteres aleatorios. Generar con: openssl rand -hex 32

ADMIN_SESSION_SECRET=
# Secreto HMAC para firmar tokens de sesión de corta duración (8h).
# Mínimo 32 bytes. Generar con: openssl rand -hex 32

# IPs o rangos CIDR autorizados para acceder al panel /backoffice desde Express (CSV, vacío = sin restricción IP extra)
# El loopback siempre está permitido; las entradas inválidas se ignoran (fail-closed).
# Ejemplo: ADMIN_ALLOWED_IPS=10.42.0.1,192.168.1.0/24,fd00::/8
ADMIN_ALLOWED_IPS=

# ------------------------------------------------------------------------------
# CORS  [REQUERIDO en prod]
# ------------------------------------------------------------------------------
CORS_ORIGINS=
# Lista de orígenes autorizados separados por coma.
# En producción es obligatorio. Ejemplo: https://pokedex.example.com,https://www.pokedex.example.com
# En desarrollo, si se deja vacío, solo se permiten orígenes localhost/127.0.0.1.

# ------------------------------------------------------------------------------
# Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
DATABASE_URL=
# String de conexión completo. Si se define, tiene precedencia sobre las variables POSTGRES_*.
# Formato: postgresql://usuario:contraseña@host:puerto/base_de_datos

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pokedex_app
POSTGRES_PASSWORD=
POSTGRES_DB=pokedex_db

# SSL para la conexión a PostgreSQL
# En producción se activa automáticamente si el host no es loopback.
# DB_SSL=true  → forzar SSL siempre
# DB_SSL=false → deshabilitar SSL siempre (solo para dev local sin TLS)
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=
# Si es "true", verifica el certificado CA del servidor Postgres. Requiere DB_SSL=true.

# ------------------------------------------------------------------------------
# Redis (Rate Limiting Distribuido + Revocación de Sesiones)
# ------------------------------------------------------------------------------
REDIS_URL=
# String de conexión completo. Si se define, tiene precedencia sobre REDIS_HOST/PORT.
# Formato: redis://:contraseña@host:puerto

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Google Gemini AI
# ------------------------------------------------------------------------------
AI_API_KEY=
GEMINI_API_KEY=
# API Key para Google Gemini. Si falta, los endpoints /api/v1/ai/* operan en modo fallback.

GEMINI_MODEL=gemini-2.5-flash
# Modelo a utilizar. Default: gemini-2.5-flash
# Referencia: https://ai.google.dev/gemini-api/docs/models/gemini

# ------------------------------------------------------------------------------
# Flags de Seguridad y Comportamiento

SKIP_ENV_CHECK=
# Si es "true", omite el chequeo de variables de entorno al arrancar.
# Útil en entornos CI/CD con configuración efímera. No usar en producción.

FORCE_SEED=
# Sin valor, `npm run seed` solo inserta los Pokémon que faltan y no pisa ediciones.
# Si es "true", reescribe todo el catálogo base. Usar solo para resets en desarrollo;
# en producción exige "OVERRIDE_PRODUCTION_CONFIRMED".

SEED_DATASET=
# Dataset de `npm run seed` (ADR-030): "sample" (35 Pokémon, por defecto) o "full"
# (catálogo nacional completo, apps/backend/src/data/pokemon-catalog.full.json).
# El dataset completo se regenera con: npx tsx scripts/generate-pokemon-catalog.ts

# ------------------------------------------------------------------------------
# Nginx Frontend — Variables para envsubst (IP Allowlist)
# Se inyectan al contenedor del frontend para reemplazar las plantillas en nginx.conf.template
# ------------------------------------------------------------------------------
BACKOFFICE_ALLOWED_IP_1=10.42.0.1/32
# IP del Kubernetes Ingress / API Server gateway (ajustar por cluster)

BACKOFFICE_ALLOWED_IP_2=192.168.1.50/32
# IP del host Bastion / VPN de gestión administrativa (ajustar por ambiente)

METRICS_ALLOWED_CIDR=10.42.0.0/24
# Subred de scraping de Prometheus (ajustar por cluster)

METRICS_BEARER_TOKEN=
# Token Bearer que exige la API en /metrics (AUD-SEC-OBS-001). Vacío = /metrics abierto.
# Generar con: openssl rand -hex 32. El scraper (Alloy/Prometheus) debe enviarlo en Authorization.

# ------------------------------------------------------------------------------
# Observabilidad (OpenTelemetry & Grafana Cloud)
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
# Endpoint del colector OTLP (Tempo, Jaeger, etc.).
# Ejemplo: http://tempo:4317
# Si se deja vacío, no se exportan trazas OTLP.

GRAFANA_CLOUD_PROMETHEUS_URL=
# Endpoint Prometheus Remote Write. Ejemplo: https://prometheus-prod-40-prod-sa-east-1.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USER=
# ID de usuario numérico de Prometheus en Grafana Cloud (ej: 3589862)
GRAFANA_CLOUD_LOKI_URL=
# Endpoint Loki Push API. Ejemplo: https://logs-prod-024.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=
# ID de usuario numérico de Loki en Grafana Cloud (ej: 1790605)
GRAFANA_CLOUD_TOKEN=
# Token de Access Policy de Grafana Cloud con scopes 'metrics:write' y 'logs:write'

# ------------------------------------------------------------------------------
# Disaster Recovery & Réplica Off-Site a Google Drive
# ------------------------------------------------------------------------------
BACKUP_ENCRYPTION_KEY=
# Clave simétrica para cifrar/descifrar volcados con AES-256-CBC PBKDF2 (min 32 chars).
# Generar con: openssl rand -hex 32

GDRIVE_CLIENT_ID=
# (Opcional) Client ID OAuth2 propio de Google Drive para rclone; vacío usa el de rclone por defecto

GDRIVE_CLIENT_SECRET=
# (Opcional) Client Secret OAuth2 propio de Google Drive para rclone

GDRIVE_TOKEN=
# Token JSON de OAuth2 obtenido mediante: rclone authorize "drive"
# Ejemplo: '{"access_token":"<ACCESS_TOKEN>","token_type":"Bearer","refresh_token":"<REFRESH_TOKEN>","expiry":"..."}'

GDRIVE_FOLDER=PokedexBackups/dev
# Carpeta de destino dentro de Google Drive

# ------------------------------------------------------------------------------
# Model Context Protocol (MCP) — Servidores y Herramientas de IA
# Ver arquitectura y catálogo canónico en .mcp/README.md
# ------------------------------------------------------------------------------
GITHUB_PERSONAL_ACCESS_TOKEN=
# Token Personal de GitHub con scopes 'repo' y 'read:org' para el servidor @modelcontextprotocol/server-github.
# Puede obtenerse con: gh auth token

SONAR_TOKEN=
# Token de análisis o consulta de proyectos en SonarQube / SonarCloud para mcp-sonarqube-launcher.

SONAR_HOST_URL=https://sonarcloud.io
# URL del servidor SonarQube (o https://sonarcloud.io si se utiliza SonarCloud).

GRAFANA_SERVICE_ACCOUNT_TOKEN=
# Token de Service Account o Access Policy de Grafana con permisos de lectura para el servidor de observabilidad MCP.
# Puede reutilizar el valor de GRAFANA_CLOUD_TOKEN si dispone de permisos de consulta.

GRAFANA_MCP_ENDPOINT=https://monitoring.pokedex.internal/mcp
# URL del endpoint remoto MCP de Grafana/Prometheus (transporte SSE/HTTP).

CONTEXT7_API_KEY=
# (Opcional) Clave API de Context7 (Upstash) para consultas de documentación técnica sin restricciones de cuota.
# Puede generarse en https://context7.com o ejecutando: npx ctx7 setup

TRIVY_GITHUB_TOKEN=
# (Opcional) Token de GitHub para Trivy MCP con el fin de evitar rate-limiting de la API al descargar
# la base de datos de vulnerabilidades (trivy-db). Si se omite, utiliza descarga anónima o GITHUB_PERSONAL_ACCESS_TOKEN.
