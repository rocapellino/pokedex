# ==============================================================================
# Variables de Entorno - Configuración del Proyecto Pokémon API
# Copiar este archivo a .env y ajustar los valores según corresponda
# ==============================================================================

# Entorno de ejecución (development, testing, production)
FLASK_ENV=production

# Puerto del servidor
PORT=5000

# Host de enlace
HOST=0.0.0.0

# Nivel de depuración (False en producción)
FLASK_DEBUG=0

# Configuración de Workers para Gunicorn (WSGI)
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
