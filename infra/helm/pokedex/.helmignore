.svn/

# Editores e IDEs
.project
.idea/
.vscode/
*.swp
*.swo

# Archivos de respaldo y temporales
*.bak
*.tmp
*.orig
*~
*.log

# Paquetes y archivos comprimidos
*.tgz
*.tar.gz
*.zip

# Secretos y credenciales
*.secrets
.env*
*.pem
*.key
*.cert
*.crt
