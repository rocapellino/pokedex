# ==============================================================================
# Variables de Ejemplo para Proxmox VE (terraform.tfvars.example)
# ==============================================================================

proxmox_endpoint       = "https://10.10.13.10:8006/"
# Autenticación segura mediante API Token (USER@REALM!TOKENID=UUID)
proxmox_api_token      = "root@pam!opentofu=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Verificación TLS estricta por defecto (false).
# Si el entorno de laboratorio/on-prem utiliza un certificado autofirmado sin CA confiable,
# configure explícitamente proxmox_insecure = true en su terraform.tfvars local no versionado.
proxmox_insecure       = false
# Tipo de cómputo y entorno:
# compute_type: "lxc" (ultraliviano para preprod/lab) o "vm" (aislamiento KVM completo para prod)
compute_type           = "lxc"
environment_tier       = "preprod"

node_name              = "pve"
vm_count               = 1
vm_cores               = 4
vm_memory              = 5120
vm_disk_size           = 32
# Plantilla LXC descargada mediante HTTPS con verificación criptográfica SHA256 (Supply Chain Security):
lxc_template_url                = "https://mirrors.ustc.edu.cn/proxmox/images/system/debian-12-standard_12.12-1_amd64.tar.zst"
lxc_template_file_name          = "debian-12-standard_12.12-1_amd64.tar.zst"
lxc_template_checksum           = "ff5c55cba730fc1e93bc7de3e0ea4aecb05c692094009cfcf2999973a56f15e5"
lxc_template_checksum_algorithm = "sha256"
network_bridge         = "vmbr0"
network_ip             = "10.10.13.100/24"
network_gateway        = "10.10.13.1"
ssh_public_key         = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKey devops@proxmox"
# Contraseña de consola opcional (por defecto null, acceso estrictamente por SSH key):
# vm_user_password     = "CUSTOM_SECRET_PASSWORD"

# Configuración de HashiCorp Vault (Community Edition) LXC:
vault_enabled          = true
vault_vm_id            = 810
vault_hostname         = "vault"
vault_cores            = 2
vault_memory           = 1024
vault_disk_size        = 16
vault_network_ip       = "10.10.13.110/24"
vault_unprivileged     = true

# Configuración del Bastion Host y Automatización Centralizada LXC:
bastion_enabled      = true
bastion_vm_id        = 820
bastion_hostname     = "bastion"
bastion_cores        = 2
bastion_memory       = 1024
bastion_disk_size    = 16
bastion_network_ip   = "10.10.13.120/24"
bastion_unprivileged = true


