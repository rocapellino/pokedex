# ==============================================================================
# Blueprint Template: Inyección de Credenciales Off-site desde Vault (ESO)
# ESTADO: PLANTILLA / ESQUELETO INACTIVO (Cloud-Ready)
# ==============================================================================
# Instrucciones de Activación:
# 1. Almacenar credenciales del bucket S3/R2 en Vault:
#    vault kv put secret/pokedex/prod/backup-offsite \
#      AWS_ACCESS_KEY_ID="<clave-acceso>" \
#      AWS_SECRET_ACCESS_KEY="<clave-secreta>" \
#      OFFSITE_ENDPOINT="https://<id>.r2.cloudflarestorage.com"
# 2. Renombrar este archivo a .yaml y aplicar en el clúster cuando se disponga del bucket.
# ==============================================================================
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: backup-offsite-credentials-sync
  namespace: pokemon-app
  labels:
    app.kubernetes.io/name: pokedex
    app.kubernetes.io/component: disaster-recovery
    app.kubernetes.io/part-of: pokedex-platform
spec:
  refreshInterval: "1h"
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: backup-offsite-creds
    creationPolicy: Owner
    template:
      type: Opaque
      metadata:
        labels:
          app.kubernetes.io/managed-by: external-secrets
  data:
    - secretKey: AWS_ACCESS_KEY_ID
      remoteRef:
        key: pokedex/prod/backup-offsite
        property: AWS_ACCESS_KEY_ID
    - secretKey: AWS_SECRET_ACCESS_KEY
      remoteRef:
        key: pokedex/prod/backup-offsite
        property: AWS_SECRET_ACCESS_KEY
    - secretKey: OFFSITE_ENDPOINT
      remoteRef:
        key: pokedex/prod/backup-offsite
        property: OFFSITE_ENDPOINT
