// ==============================================================================
// Grafana Alloy - Recolección Local Multi-Servicio & Logs -> Grafana Cloud
// ==============================================================================

// 1. Recolectar métricas expuestas por la API de Pokédex
prometheus.scrape "pokedex_api" {
	targets = [
		{
			"__address__"      = "api:3000",
			"__metrics_path__" = "/metrics",
			"app"              = "pokemon-api",
			"instance"         = "pokedex-local-dev",
			"environment"      = "development",
		},
	]
	forward_to      = [prometheus.remote_write.metrics_hosted_prometheus.receiver]
	scrape_interval = "5s"
	scrape_timeout  = "4s"
}

// 2. Exporter nativo embebido y recolección de métricas de PostgreSQL
prometheus.exporter.postgres "postgres" {
	data_source_names = [
		sys.env("POSTGRES_DATA_SOURCE_NAME"),
	]
}

discovery.relabel "postgres" {
	targets = prometheus.exporter.postgres.postgres.targets

	rule {
		target_label = "app"
		replacement  = "pokemon-postgres"
	}

	rule {
		target_label = "instance"
		replacement  = "pokedex-postgres-dev"
	}

	rule {
		target_label = "environment"
		replacement  = "development"
	}
}

prometheus.scrape "postgres" {
	targets         = discovery.relabel.postgres.output
	forward_to      = [prometheus.remote_write.metrics_hosted_prometheus.receiver]
	scrape_interval = "5s"
	scrape_timeout  = "4s"
}

// 3. Exporter nativo embebido y recolección de métricas de Redis
prometheus.exporter.redis "redis" {
	redis_addr     = sys.env("REDIS_ADDR")
	redis_password = sys.env("REDIS_PASSWORD")
}

discovery.relabel "redis" {
	targets = prometheus.exporter.redis.redis.targets

	rule {
		target_label = "app"
		replacement  = "pokemon-redis"
	}

	rule {
		target_label = "instance"
		replacement  = "pokedex-redis-dev"
	}

	rule {
		target_label = "environment"
		replacement  = "development"
	}
}

prometheus.scrape "redis" {
	targets         = discovery.relabel.redis.output
	forward_to      = [prometheus.remote_write.metrics_hosted_prometheus.receiver]
	scrape_interval = "5s"
	scrape_timeout  = "4s"
}

// 4. Recolectar métricas de Contenedores Docker vía cAdvisor
prometheus.scrape "cadvisor" {
	targets = [
		{
			"__address__"      = "cadvisor:8080",
			"__metrics_path__" = "/metrics",
			"app"              = "docker-cadvisor",
			"instance"         = "pokedex-cadvisor-dev",
			"environment"      = "development",
		},
	]
	forward_to      = [prometheus.remote_write.metrics_hosted_prometheus.receiver]
	scrape_interval = "5s"
	scrape_timeout  = "4s"
}

// 5. Exportar métricas mediante Remote Write a Grafana Cloud Prometheus
prometheus.remote_write "metrics_hosted_prometheus" {
	endpoint {
		name = "hosted-prometheus"
		url  = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USER")
			password = sys.env("GRAFANA_CLOUD_TOKEN")
		}
	}
}

// ==============================================================================
// 6. Recolección de Logs de Contenedores Docker -> Grafana Cloud Loki
// ==============================================================================

discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "app"
	}
}

loki.source.docker "docker_logs" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.docker_logs.output
	forward_to = [loki.write.grafana_cloud_loki.receiver]
}

loki.write "grafana_cloud_loki" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOKI_USER")
			password = sys.env("GRAFANA_CLOUD_TOKEN")
		}
	}
}
