      },
      "id": 101,
      "panels": [],
      "title": "Estado del servicio",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Resultado del último scraping de /metrics de la API. Caída equivale a la alerta PokedexAPIDown.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "Caída"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "Arriba"
                }
              }
            }
          ],
          "noValue": "Sin datos",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
