          "editorMode": "code",
          "expr": "max(up{app=\"pokemon-api\", environment=\"$environment\"})",
          "legendFormat": "API (scraping)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "API (scraping)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
